# Same machine as the API: keep host.docker.internal (not the LAN IP).
# A LAN IP like http://192.168.x.x:3200 from inside Docker is ECONNREFUSED.
RVS_API_BASE_URL=http://host.docker.internal:3200
RVS_WORKER_TOKEN=replace-with-a-secret
RVS_WORKER_CAPABILITIES=compiler,renderer
RVS_HEARTBEAT_INTERVAL_MS=30000
RVS_POLL_INTERVAL_MS=5000
RVS_API_REQUEST_TIMEOUT_MS=30000
RVS_MEDIA_REQUEST_TIMEOUT_MS=1800000
